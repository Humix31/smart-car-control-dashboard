PORT=3000
SIMULATION_MODE=true
# Local-only sample. Set a unique value in production.
CONTROL_TOKEN=local-dev-control-token
# Optional public URL for the ESP32-CAM stream. Defaults to the configured
# camera IP in client/src/config/camera.js and uses its /stream endpoint.
VITE_CAMERA_STREAM_URL=
# Vite options are read when the frontend is built. Demo video and ICE settings
# are retained for deployments that use the corresponding optional UI features.
VITE_DEMO_MODE=false
VITE_DEMO_VIDEO_URL=
# Optional JSON array of your own STUN/TURN servers, for example [{"urls":"turn:turn.example.net","username":"user","credential":"secret"}]
VITE_ICE_SERVERS=
